<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:onClick="regresarALogin">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        tools:context=".SignUpActivity">

        <TextView
            android:id="@+id/crearCuentaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Crear Cuenta"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Cédula -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/cedulaInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Cédula"
            app:layout_constraintTop_toBottomOf="@+id/crearCuentaTitulo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cedulaInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:inputType="number"
                android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nombres -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nombresInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nombres"
            app:layout_constraintTop_toBottomOf="@+id/cedulaInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nombresInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Apellidos -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/apellidosInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Apellidos"
            app:layout_constraintTop_toBottomOf="@+id/nombresInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/apellidosInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Edad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edadInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Edad"
            app:layout_constraintTop_toBottomOf="@+id/apellidosInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edadInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nacionalidad (Spinner) -->
        <TextView
            android:id="@+id/nacionalidadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nacionalidad"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edadInputLayout" />

        <Spinner
            android:id="@+id/nacionalidadSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/nacionalidadLabel" />

        <!-- Género (Spinner) -->
        <TextView
            android:id="@+id/generoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Género"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nacionalidadSpinner" />

        <Spinner
            android:id="@+id/generoSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/generoLabel" />

        <!-- Estado Civil (Radio Buttons) -->
        <TextView
            android:id="@+id/estadoCivilLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Estado Civil"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/generoSpinner" />

        <RadioGroup
            android:id="@+id/estadoCivilGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/estadoCivilLabel">

            <RadioButton
                android:id="@+id/radioSoltero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soltero/a" />

            <RadioButton
                android:id="@+id/radioCasado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Casado/a" />
        </RadioGroup>

        <!-- Fecha de Nacimiento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/fechaNacLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:hint="Fecha de Nacimiento"
            app:layout_constraintEnd_toStartOf="@+id/fechaBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/estadoCivilGroup">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fechaNacInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/fechaBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            app:layout_constraintBottom_toBottomOf="@+id/fechaNacLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/fechaNacLayout" />

        <!-- Nivel de Inglés -->
        <TextView
            android:id="@+id/nivelInglesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nivel de Inglés"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fechaNacLayout" />

        <RatingBar
            android:id="@+id/nivelInglesRating"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:isIndicator="false"
            android:numStars="5"
            android:stepSize="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nivelInglesLabel" />

        <!-- Botones -->
        <Button
            android:id="@+id/registrarBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#323F8E"
            android:text="Registrar"
            app:layout_constraintEnd_toStartOf="@+id/mostrarBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nivelInglesRating" />

        <Button
            android:id="@+id/mostrarBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:backgroundTint="#323F8E"
            android:text="Mostrar"
            app:layout_constraintBottom_toBottomOf="@+id/registrarBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/registrarBtn"
            app:layout_constraintTop_toTopOf="@+id/registrarBtn" />

        <Button
            android:id="@+id/borrarBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:text="Borrar"
            app:layout_constraintEnd_toStartOf="@+id/cancBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/registrarBtn" />

        <Button
            android:id="@+id/cancBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Cancelar"
            app:layout_constraintBottom_toBottomOf="@+id/borrarBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/borrarBtn"
            app:layout_constraintTop_toTopOf="@+id/borrarBtn" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>