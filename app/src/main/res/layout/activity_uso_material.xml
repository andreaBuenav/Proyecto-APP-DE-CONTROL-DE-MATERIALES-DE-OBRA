<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarUsoMaterial"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#1A237E"
            android:title="Uso de Material"
            android:titleTextColor="@android:color/white"
            app:titleTextColor="@android:color/white"
            app:navigationIconTint="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrar consumo de material"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Material"
                android:textStyle="bold"
                android:textColor="#424242"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spMaterialUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvStockDisponible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stock disponible:"
                android:textColor="#00695C"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etObraUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Obra"
                android:inputType="textCapWords"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etActividadUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Actividad"
                android:inputType="textCapSentences"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etCantidadUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cantidad utilizada"
                android:inputType="numberDecimal"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etObservacionUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Observación"
                android:gravity="top"
                android:minLines="3"
                android:inputType="textMultiLine"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnGuardarUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar uso de material"
                android:backgroundTint="#1A237E"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>